<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CobrarCuotaActivity">

    <LinearLayout
        android:id="@+id/cobrarCuota"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/fondo">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo_fitness"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fitness Center"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="@font/letra_marca"
            android:layout_marginBottom="24dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Búsqueda por DNI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ingrese Número DNI del Socio"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDni"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_blanco"
                        android:hint="DNI"
                        android:imeOptions="actionSearch"
                        android:inputType="number"
                        android:maxLength="8"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/texto_home"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnBuscar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Buscar"
                        android:backgroundTint="@color/botones"
                        android:textColor="@color/black"
                        app:cornerRadius="8dp"/>
                </LinearLayout>

                <!-- Datos del socio encontrado -->
                <LinearLayout
                    android:id="@+id/panelSocio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/fondo_blanco"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNombreSocio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvEstadoCuota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/apto_fisico"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDatosSocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/black"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Forma de pago (solo si debe la cuota) -->
                <LinearLayout
                    android:id="@+id/panelPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Forma de Pago"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgMedioPago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/borde_blanco"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <RadioButton
                            android:id="@+id/rbEfectivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/radio_tint"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>

                        <RadioButton
                            android:id="@+id/rb3Cuotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/radio_tint"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>

                        <RadioButton
                            android:id="@+id/rb6Cuotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/radio_tint"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Acciones: siempre visibles abajo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPagarCuota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Pagar Cuota"
                android:backgroundTint="@color/botones"
                android:textColor="@color/black"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnMostrarCarnet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Mostrar Carnet"
                android:backgroundTint="@color/botones"
                android:textColor="@color/black"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="32dp"
            android:text="Volver"
            android:backgroundTint="@color/botones"
            android:textColor="@color/black"
            app:cornerRadius="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
