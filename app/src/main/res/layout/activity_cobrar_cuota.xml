<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CobrarCuotaActivity">

    <LinearLayout
        android:id="@+id/cobrarCuota"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/fondo">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo_fitness"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fitness Center"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="@font/letra_marca"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobrar Cuota"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Búsqueda por DNI -->
                <EditText
                    android:id="@+id/etDni"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/campo_textologin"
                    android:hint="DNI del socio"
                    android:inputType="number"
                    android:maxLength="8"
                    android:drawableStart="@drawable/ic_usuario"
                    android:drawablePadding="10dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="20dp"/>

                <Button
                    android:id="@+id/btnBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar Socio"
                    android:backgroundTint="@color/botones"
                    android:textColor="@color/black"
                    android:layout_marginBottom="30dp"/>

                <!-- Datos del socio encontrado -->
                <LinearLayout
                    android:id="@+id/panelSocio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/carnet_panel"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvNombreSocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvNumeroSocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/tvDniSocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvEstadoCuota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/apto_fisico"
                        android:gravity="center"
                        android:padding="8dp"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Medios de pago (solo si debe la cuota) -->
                <LinearLayout
                    android:id="@+id/panelPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMontoCuota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="¿Cómo desea abonar?"
                        android:textColor="@color/white"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnEfectivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Efectivo"
                        android:backgroundTint="@color/botones"
                        android:textColor="@color/black"
                        android:layout_marginBottom="20dp"/>

                    <Button
                        android:id="@+id/btn3Cuotas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/botones"
                        android:textColor="@color/black"
                        android:layout_marginBottom="20dp"/>

                    <Button
                        android:id="@+id/btn6Cuotas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/botones"
                        android:textColor="@color/black"
                        android:layout_marginBottom="20dp"/>
                </LinearLayout>

                <!-- Comprobante de pago -->
                <LinearLayout
                    android:id="@+id/panelComprobante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/carnet_panel"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="COMPROBANTE DE PAGO"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvComprobante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnVerCarnet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver Carnet del Socio"
                    android:backgroundTint="@color/botones"
                    android:textColor="@color/black"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:backgroundTint="@color/botones"
            android:textColor="@color/black"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
